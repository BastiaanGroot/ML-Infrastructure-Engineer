# One torchrun worker per node, shared by every experiment. Rendered by
# ../launch.py (replaces only its own ${NAME}-style keys; shell variables
# like $NODE_RANK are left for the container), which also regenerates the
# qwen3-training-scripts ConfigMap from ../scripts/. See ../README.md.
#
# Indexed Job: each pod's JOB_COMPLETION_INDEX is its torchrun node rank, and
# the headless Service + subdomain give pod 0 a stable DNS name for
# rendezvous (<job>-0.<job>.default.svc.cluster.local).
#
# InfiniBand: pods are privileged with the host's /dev/infiniband mounted so
# NCCL can use the GPU cluster's IB fabric (the nodes don't advertise RDMA
# devices to Kubernetes without DRA - see the root README's Hardware section).
apiVersion: v1
kind: Service
metadata:
  name: ${NAME}
  namespace: default
spec:
  clusterIP: None
  selector:
    job-name: ${NAME}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: ${NAME}
  namespace: default
  labels:
    app: qwen3-training
spec:
  completions: ${NNODES}
  parallelism: ${NNODES}
  completionMode: Indexed
  # 0 for experiments; e2e runs retry, and a retried pod resumes from the
  # latest checkpoint (see ../README.md "Automatic recovery").
  backoffLimit: ${BACKOFF_LIMIT}
  template:
    metadata:
      labels:
        app: qwen3-training
        experiment: ${NAME}
    spec:
      subdomain: ${NAME}
      restartPolicy: Never
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchExpressions:
                  - {key: experiment, operator: In, values: [${NAME}]}
              topologyKey: kubernetes.io/hostname
      volumes:
        - name: scripts
          configMap:
            name: qwen3-training-scripts
        # 8 local ranks' DataLoader workers + NCCL shared-memory transport
        # need far more than the container's default 64MB /dev/shm.
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: 64Gi
        - name: infiniband
          hostPath:
            path: /dev/infiniband
        # Tokenized datasets, checkpoints and the HF cache (see prepare-data.yaml).
        - name: shared-fs
          hostPath:
            path: /mnt/filesystem-s6
            type: Directory
      containers:
        - name: worker
          image: nvcr.io/nvidia/nemo:25.09
          securityContext:
            privileged: true
          envFrom:
            - secretRef:
                name: mlflow-creds
          env:
            - name: MASTER_ADDR
              value: ${NAME}-0.${NAME}.default.svc.cluster.local
            - name: MASTER_PORT
              value: "29500"
            - name: MLFLOW_TRACKING_URI
              value: ${MLFLOW_TRACKING_URI}
            - name: NCCL_DEBUG
              value: ${NCCL_DEBUG}
            - name: NCCL_SOCKET_IFNAME
              value: eth0
            - name: HF_HOME
              value: /mnt/shared-fs/hf-cache
          volumeMounts:
            - {name: scripts, mountPath: /scripts}
            - {name: dshm, mountPath: /dev/shm}
            - {name: infiniband, mountPath: /dev/infiniband}
            - {name: shared-fs, mountPath: /mnt/shared-fs}
          command: ["/bin/bash", "-c"]
          args:
            - |
              set -euo pipefail
              pip install --quiet mlflow-skinny==3.16.1
              cd /opt/Megatron-Bridge
              export PYTHONPATH=/opt/Megatron-Bridge/src:/opt/megatron-lm:${PYTHONPATH:-}
              # Privileged containers see every GPU on the node regardless of
              # the allocation, so each pod claims the whole node (see limits)
              # and uses only its first NPROC GPUs.
              export CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((${NPROC} - 1)))
              NODE_RANK=$JOB_COMPLETION_INDEX
              echo "=== ${NAME} - node-rank=$NODE_RANK ==="
              launch=(torchrun --nnodes=${NNODES} --nproc-per-node=${NPROC} ${RDZV_ARGS}
                /scripts/${SCRIPT} ${SCRIPT_ARGS})
              if [ "${PROFILE}" = 1 ] && [ "$NODE_RANK" = 0 ]; then
                nsys profile --trace=cuda,nvtx,osrt --force-overwrite=true -o /tmp/profile "${launch[@]}"
                echo "=== nsys stats: top CUDA kernels by total GPU time ==="
                nsys stats --report cuda_gpu_kern_sum --format column /tmp/profile.nsys-rep
              else
                "${launch[@]}"
              fi
          resources:
            limits:
              nvidia.com/gpu: 8
